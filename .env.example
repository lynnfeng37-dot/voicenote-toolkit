# VoiceNote never enables a cloud provider implicitly.
VOICENOTE_TRANSCRIPTION_PROVIDER=
VOICENOTE_TRANSCRIPTION_MODEL=
VOICENOTE_CORRECTION_PROVIDER=
VOICENOTE_CORRECTION_MODEL=
VOICENOTE_REASONING_PROVIDER=
VOICENOTE_REASONING_MODEL=
OPENAI_API_KEY=

# Consent gates. Merely setting OPENAI_API_KEY does not enable cloud processing.
VOICENOTE_ALLOW_CLOUD_PROCESSING=false
VOICENOTE_ALLOW_MODEL_DOWNLOAD=false
VOICENOTE_LOCAL_DEVICE=auto
VOICENOTE_LOCAL_COMPUTE_TYPE=default

# Keep generated files outside the source tree when possible.
VOICENOTE_OUTPUT_DIR=./output
VOICENOTE_LOG_LEVEL=INFO

